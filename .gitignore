# Секреты и окружение
.env
*.env
!*.env.example

# Локальные параметры деплоя (реальный хост/доступы)
deploy.conf

# Служебные и внутренние материалы — только локально, в публичный git не входят
.scratch/
summary.md
workflows/
docs/
.hermes/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Инструменты
.codegraph*/
.superpowers/
.worktrees/
.DS_Store

# Arduino build artifacts

# Тяжёлые артефакты отладки — не в git
build/*.bin
build/*.elf
build/*.map
build/cache/
build/core/
build/libraries/
build/sketch/
build/*.json
build/file_opts
build/flash_args
build/*.cache
build/sdkconfig
build/partitions.csv
build/build_opt.h

# Промежуточные артефакты сборки (релиз собирается в build/ через scripts/package_build.sh)
.build/
